  "JUKNIS": [
    {
      "id": "JUK-A",
      "section_code": "A",
      "title": "LATAR BELAKANG DAN TUJUAN",
      "content": "Dalam rangka memperingati Hari Guru Nasional Tahun 2026, FKKKS Kecamatan Beji menyelenggarakan Lomba Video Guru Inspiratif untuk menggali, mengapresiasi, dan mendiseminasikan praktik baik serta inovasi pembelajaran guru.",
      "sort_order": 1,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-B",
      "section_code": "B",
      "title": "KETENTUAN PESERTA",
      "content": "1. Peserta merupakan guru aktif di sekolah dasar se-Kecamatan Beji.\n2. Kepesertaan bersifat wajib bagi setiap lembaga.\n3. Setiap sekolah mengirimkan minimal satu guru sebagai perwakilan.",
      "sort_order": 2,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-C",
      "section_code": "C",
      "title": "KETENTUAN KARYA",
      "content": "Tema bebas, dengan fokus inovasi pembelajaran.\nMateri dapat berupa: Metode pembelajaran, Media pembelajaran, Alat peraga, Program inovatif kelas, atau Strategi pembelajaran lainnya.\n\nWajib menerapkan prinsip Pembelajaran Mendalam:\n- Joyful Learning\n- Meaningful Learning\n- Mindful Learning\n\nVideo harus mengikuti alur STAR (Situasi, Tantangan, Aksi, Refleksi/Hasil).\nDurasi video minimal 5 menit dan maksimal 7 menit.\nVideo wajib memiliki bukti praktik nyata dan testimoni dari pihak yang relevan (siswa, guru sejawat, atau kepala sekolah).\n\nDokumen wajib:\n1. Video praktik baik\n2. Modul Ajar\n3. Dokumentasi Media Pembelajaran\n\nKarya wajib orisinal, belum pernah diikutkan lomba sejenis, dan sudah dipraktikkan di sekolah asal.",
      "sort_order": 3,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-D",
      "section_code": "D",
      "title": "MEKANISME PENJURIAN",
      "content": "Tahap 1 — Seleksi Video: Dewan juri melakukan penilaian terhadap seluruh karya untuk menentukan Top 5.\nTahap 2 — Final: Lima finalis melakukan paparan luring dan mempertanggungjawabkan inovasi pembelajaran.\n\nDewan juri terdiri dari unsur Korwilcam, Pengawas, dan Praktisi.\nKeputusan dewan juri bersifat mutlak dan tidak dapat diganggu gugat.",
      "sort_order": 4,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-E",
      "section_code": "E",
      "title": "WAKTU PELAKSANAAN",
      "content": "Deadline pengumpulan: 21 November 2026, 23.59 WIB.\nPenyisihan: 23–25 November 2026.\nFinal: 26–27 November 2026.\nPengumuman pemenang: 28 November 2026.",
      "sort_order": 5,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-F",
      "section_code": "F",
      "title": "TATA CARA PENGUMPULAN",
      "content": "Peserta menyiapkan Google Drive folder berisi: Video, Modul Ajar, dan Media Pembelajaran.\nFolder harus diatur agar dapat dilihat oleh siapa saja yang memiliki tautan (Anyone with the link can view).\nPeserta tidak diwajibkan mengunggah video ke YouTube pribadi.\nPanitia dapat mengunggah ulang karya ke kanal YouTube K3S sebagai arsip dan referensi pendidikan.\nPeserta mengirimkan identitas dan tautan karya melalui formulir pengumpulan resmi.",
      "sort_order": 6,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-G",
      "section_code": "G",
      "title": "KRITERIA PENILAIAN",
      "content": "Pedagogik dan Inovasi: 40%.\nDampak / Hasil Nyata: 35%.\nKualitas Teknis Video: 25%.",
      "sort_order": 7,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    },
    {
      "id": "JUK-H",
      "section_code": "H",
      "title": "APRESIASI",
      "content": "Juara I: Rp1.000.000 + Piagam Penghargaan.\nJuara II: Rp750.000 + Piagam Penghargaan.\nJuara III: Rp500.000 + Piagam Penghargaan.\nJuara Harapan I: Rp300.000 + Piagam Penghargaan.\nJuara Harapan II: Rp200.000 + Piagam Penghargaan.",
      "sort_order": 8,
      "active": true,
      "updated_at": "2026-10-31T19:45:05+07:00"
    }
  ],
